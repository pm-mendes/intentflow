# === CLÉS API ===
# Obtenir sur platform.openai.com
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0

# === LOGGING ===
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_DIR=./data/results

# === EXPÉRIENCES ===
RANDOM_SEED=42                      # Fixer pour reproductibilité
NUM_TASKS_BENIGN=10
NUM_TASKS_ATTACKED=10
INJECTED_DOCUMENT_RATIO=0.3         # 30% de documents malveillants dans le corpus

# === RAG ===
RAG_TOP_K=3                         # Nombre de documents récupérés par requête
RAG_CONFIDENCE_THRESHOLD=0.5

# === PIPELINE DE SÉCURITÉ ===
ENABLE_PROVENANCE_TRACKING=true
ENABLE_INTENT_VALIDATION=true
BLOCK_ON_POLICY_VIOLATION=true

# === TIMEOUTS (ms) ===
INTENT_EXTRACTION_TIMEOUT=5000
TOOL_EXECUTION_TIMEOUT=10000
